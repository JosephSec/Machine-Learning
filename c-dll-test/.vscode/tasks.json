{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile DLL",
      "type": "shell",
      "command": "g++",
      "args": [
        "-DPYLIB_EXPORT",

        "-I${workspaceFolder}",
        "${workspaceFolder}/main.c",

        "-m64", "-O3", "-flto","-shared",
        "-o", "${workspaceFolder}/bin/clib.dll",

        "-static", "-static-libgcc", "-static-libstdc++",
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
