{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CompileExe",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-D_UCRT",
        
        "-O3", "-flto",

        "-I${workspaceFolder}/include",

        "-o", "${workspaceFolder}/build/program.exe",

        "${workspaceFolder}/src/main.c",

        "-lucrt",
      ]
    },
    {
      "label": "Create Object Files",
