      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/dll_program.exe",
      "externalConsole": true,
      "preLaunchTask": "EXE with DLL"
    },
    {
      "name": "Update Tool",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/dll_program.exe",
      "externalConsole": true,
      "preLaunchTask": "Update Tool"
    }
  ]
}